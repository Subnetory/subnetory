{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Subnetory Helm values",
  "type": "object",
  "required": [
    "replicaCount",
    "image",
    "secrets",
    "serviceAccount",
    "podSecurityContext",
    "containerSecurityContext",
    "temporaryDirectory",
    "service",
    "application",
    "postgresql",
    "externalDatabase",
    "backup",
    "backupApp",
    "ingress",
    "networkPolicy"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy", "imagePullSecrets"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecretRuntime", "existingSecretBootstrap", "encryptionKeyEnabled", "backupEncryptionKeyEnabled"],
      "properties": {
        "existingSecretRuntime": {"type": "string", "minLength": 1},
        "existingSecretBootstrap": {"type": "string", "minLength": 1},
        "encryptionKeyEnabled": {"type": "boolean"},
        "backupEncryptionKeyEnabled": {"type": "boolean"}
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runAsNonRoot",
        "runAsUser",
        "runAsGroup",
        "fsGroup",
        "fsGroupChangePolicy",
        "seccompProfile"
      ],
      "properties": {
        "runAsNonRoot": {"const": true},
        "runAsUser": {"type": "integer", "minimum": 1},
        "runAsGroup": {"type": "integer", "minimum": 1},
        "fsGroup": {"type": "integer", "minimum": 1},
        "fsGroupChangePolicy": {
          "type": "string",
          "enum": ["Always", "OnRootMismatch"]
        },
        "seccompProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {"const": "RuntimeDefault"}
          }
        }
      }
    },
    "containerSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowPrivilegeEscalation",
        "capabilities",
        "readOnlyRootFilesystem"
      ],
      "properties": {
        "allowPrivilegeEscalation": {"const": false},
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["drop"],
          "properties": {
            "drop": {
              "type": "array",
              "minItems": 1,
              "contains": {"const": "ALL"},
              "items": {"type": "string"}
            }
          }
        },
        "readOnlyRootFilesystem": {"const": true}
      }
    },
    "temporaryDirectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sizeLimit"],
      "properties": {
        "sizeLimit": {"$ref": "#/definitions/quantity"}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serverPort",
        "terminationGracePeriodSeconds",
        "resources",
        "startupProbe",
        "livenessProbe",
        "readinessProbe"
      ],
      "properties": {
        "serverPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 40},
        "resources": {"$ref": "#/definitions/resources"},
        "startupProbe": {"$ref": "#/definitions/probe"},
        "livenessProbe": {"$ref": "#/definitions/probe"},
        "readinessProbe": {"$ref": "#/definitions/probe"}
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "auth",
        "service",
        "persistence",
        "podSecurityContext",
        "containerSecurityContext",
        "temporaryDirectory",
        "runtimeDirectory",
        "terminationGracePeriodSeconds",
        "startupProbe",
        "livenessProbe",
        "readinessProbe",
        "resources"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+-alpine[0-9]+\\.[0-9]+$"},
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["database", "username"],
          "properties": {
            "database": {"type": "string", "minLength": 1},
            "username": {"type": "string", "minLength": 1}
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "size", "storageClass", "accessModes"],
          "properties": {
            "enabled": {"const": true},
            "size": {"$ref": "#/definitions/quantity"},
            "storageClass": {"type": "string"},
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadOnlyMany", "ReadWriteOncePod"]
              }
            }
          }
        },
        "podSecurityContext": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runAsNonRoot",
            "runAsUser",
            "runAsGroup",
            "fsGroup",
            "fsGroupChangePolicy",
            "seccompProfile"
          ],
          "properties": {
            "runAsNonRoot": {"const": true},
            "runAsUser": {"type": "integer", "minimum": 1},
            "runAsGroup": {"type": "integer", "minimum": 1},
            "fsGroup": {"type": "integer", "minimum": 1},
            "fsGroupChangePolicy": {
              "type": "string",
              "enum": ["Always", "OnRootMismatch"]
            },
            "seccompProfile": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {
                "type": {"const": "RuntimeDefault"}
              }
            }
          }
        },
        "containerSecurityContext": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowPrivilegeEscalation",
            "capabilities",
            "readOnlyRootFilesystem"
          ],
          "properties": {
            "allowPrivilegeEscalation": {"const": false},
            "capabilities": {
              "type": "object",
              "additionalProperties": false,
              "required": ["drop"],
              "properties": {
                "drop": {
                  "type": "array",
                  "minItems": 1,
                  "contains": {"const": "ALL"},
                  "items": {"type": "string"}
                }
              }
            },
            "readOnlyRootFilesystem": {"const": true}
          }
        },
        "temporaryDirectory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sizeLimit"],
          "properties": {
            "sizeLimit": {"$ref": "#/definitions/quantity"}
          }
        },
        "runtimeDirectory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sizeLimit"],
          "properties": {
            "sizeLimit": {"$ref": "#/definitions/quantity"}
          }
        },
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 30},
        "startupProbe": {"$ref": "#/definitions/probe"},
        "livenessProbe": {"$ref": "#/definitions/probe"},
        "readinessProbe": {"$ref": "#/definitions/probe"},
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "externalDatabase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "host", "port", "database", "username", "sslMode"],
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "database": {"type": "string", "minLength": 1},
        "username": {"type": "string", "minLength": 1},
        "sslMode": {
          "type": "string",
          "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"]
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "timeZone", "persistence", "job", "schedules"],
      "properties": {
        "enabled": {"type": "boolean"},
        "timeZone": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*$"
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingClaim",
            "size",
            "storageClass",
            "accessModes",
            "resourcePolicy"
          ],
          "properties": {
            "existingClaim": {"type": "string"},
            "size": {"$ref": "#/definitions/quantity"},
            "storageClass": {"type": "string"},
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadOnlyMany", "ReadWriteOncePod"]
              }
            },
            "resourcePolicy": {
              "type": "string",
              "enum": ["keep", "delete"]
            }
          }
        },
        "job": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "successfulJobsHistoryLimit",
            "failedJobsHistoryLimit",
            "startingDeadlineSeconds",
            "backoffLimit",
            "activeDeadlineSeconds",
            "temporaryDirectory",
            "resources"
          ],
          "properties": {
            "successfulJobsHistoryLimit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "failedJobsHistoryLimit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "startingDeadlineSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "backoffLimit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "activeDeadlineSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 86400
            },
            "temporaryDirectory": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sizeLimit"],
              "properties": {
                "sizeLimit": {"$ref": "#/definitions/quantity"}
              }
            },
            "resources": {"$ref": "#/definitions/resources"}
          }
        },
        "schedules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hourly", "daily", "monthly", "quarterly"],
          "properties": {
            "hourly": {"$ref": "#/definitions/backupSchedule"},
            "daily": {"$ref": "#/definitions/backupSchedule"},
            "monthly": {"$ref": "#/definitions/backupSchedule"},
            "quarterly": {"$ref": "#/definitions/backupSchedule"}
          }
        }
      }
    },
    "backupApp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "cron",
        "retentionCount",
        "storagePath",
        "timeoutSeconds",
        "persistence"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "cron": {
          "type": "string",
          "pattern": "^\\S+(?:\\s+\\S+){5}$"
        },
        "retentionCount": {"type": "integer", "minimum": 1},
        "storagePath": {"type": "string", "minLength": 1, "pattern": "^/"},
        "timeoutSeconds": {"type": "integer", "minimum": 1},
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingClaim",
            "size",
            "storageClass",
            "accessModes",
            "resourcePolicy"
          ],
          "properties": {
            "existingClaim": {"type": "string"},
            "size": {"$ref": "#/definitions/quantity"},
            "storageClass": {"type": "string"},
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadOnlyMany", "ReadWriteOncePod"]
              }
            },
            "resourcePolicy": {
              "type": "string",
              "enum": ["keep", "delete"]
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "className", "annotations", "hosts", "tls", "trustedProxyCidrs"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "trustedProxyCidrs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "paths"],
            "properties": {
              "host": {"type": "string", "minLength": 1},
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "pathType"],
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "pathType": {
                      "type": "string",
                      "enum": ["Exact", "Prefix", "ImplementationSpecific"]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["secretName", "hosts"],
            "properties": {
              "secretName": {"type": "string", "minLength": 1},
              "hosts": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "allowedScanCidrs", "externalDatabaseCidrs"],
      "properties": {
        "enabled": {"type": "boolean"},
        "allowedScanCidrs": {
          "type": "array",
          "items": {"$ref": "#/definitions/cidr"}
        },
        "externalDatabaseCidrs": {
          "type": "array",
          "items": {"$ref": "#/definitions/cidr"}
        },
        "ingressFrom": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "namespaceSelector": {"type": "object", "additionalProperties": true},
              "podSelector": {"type": "object", "additionalProperties": true},
              "ipBlock": {"type": "object", "additionalProperties": true}
            }
          }
        },
        "allowAllIngressSources": {"type": "boolean"}
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "postgresql": {
          "properties": {"enabled": {"const": true}}
        },
        "externalDatabase": {
          "properties": {"enabled": {"const": false}}
        }
      }
    },
    {
      "properties": {
        "postgresql": {
          "properties": {"enabled": {"const": false}}
        },
        "externalDatabase": {
          "properties": {
            "enabled": {"const": true},
            "host": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "ingress": {
            "properties": {"enabled": {"const": true}}
          }
        }
      },
      "then": {
        "properties": {
          "ingress": {
            "properties": {"hosts": {"minItems": 1}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "externalDatabase": {
            "properties": {"enabled": {"const": true}}
          },
          "networkPolicy": {
            "properties": {"enabled": {"const": true}}
          }
        }
      },
      "then": {
        "properties": {
          "networkPolicy": {
            "properties": {"externalDatabaseCidrs": {"minItems": 1}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "backup": {
            "properties": {"enabled": {"const": true}}
          }
        }
      },
      "then": {
        "properties": {
          "postgresql": {
            "properties": {"enabled": {"const": true}}
          },
          "externalDatabase": {
            "properties": {"enabled": {"const": false}}
          },
          "backup": {
            "properties": {
              "schedules": {
                "anyOf": [
                  {
                    "properties": {
                      "hourly": {
                        "properties": {"enabled": {"const": true}}
                      }
                    }
                  },
                  {
                    "properties": {
                      "daily": {
                        "properties": {"enabled": {"const": true}}
                      }
                    }
                  },
                  {
                    "properties": {
                      "monthly": {
                        "properties": {"enabled": {"const": true}}
                      }
                    }
                  },
                  {
                    "properties": {
                      "quarterly": {
                        "properties": {"enabled": {"const": true}}
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "cidr": {
      "type": "string",
      "pattern": "^.+/[0-9]{1,3}$"
    },
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:m|[EPTGMK]i?|e[0-9]+)?$"
    },
    "backupSchedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "schedule", "retentionDays"],
      "properties": {
        "enabled": {"type": "boolean"},
        "schedule": {
          "type": "string",
          "pattern": "^\\S+(?:\\s+\\S+){4}$"
        },
        "retentionDays": {"type": "integer", "minimum": 1}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodSeconds", "timeoutSeconds", "failureThreshold"],
      "properties": {
        "periodSeconds": {"type": "integer", "minimum": 1},
        "timeoutSeconds": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1}
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {"type": "object"},
        "requests": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
