# Paramètres non sensibles facultatifs pour Docker Compose.
# Copier ce fichier vers .env uniquement pour modifier les valeurs par défaut.
#
# Les secrets ne doivent jamais être placés dans .env. Les générer avec :
#   pwsh -File ../scripts/init-compose.ps1
# ou :
#   ../scripts/init-compose.sh

HOST_PORT=8080
# Boucle locale par défaut. Utiliser 0.0.0.0 uniquement derrière un pare-feu
# ou un reverse proxy explicitement configuré.
HOST_BIND_ADDRESS=127.0.0.1
SERVER_PORT=8080
POSTGRES_USER=subnetory

# Fuseau horaire de l'application (affichage des horodatages : dernieres
# detections d'adresses, resultats de scan, etc.). Identifiant IANA, ex :
# Europe/Paris, Europe/Brussels, America/Montreal, Africa/Casablanca...
# Liste complete : `timedatectl list-timezones` sur une machine Linux.
TZ=Europe/Paris

# Interactive API documentation (Swagger UI, /v3/api-docs). Always restricted
# to the ADMIN role (JWT Bearer token or admin web session). The production
# compose disables it by default; set to true to let admins and automation
# read the API description. false removes the endpoints entirely.
SWAGGER_ENABLED=true
