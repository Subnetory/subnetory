{
  "key": "nutanix-hpe",
  "name": "Nutanix - HPE (hosts, CVM, iLO)",
  "description": "Nutanix cluster on HPE nodes: all hosts, then all CVMs, then all iLO.",
  "definition": {
    "allocation": "groups-sequential",
    "groupGap": 0,
    "ipStep": 1,
    "onOccupied": "block",
    "groups": [
      {
        "role": "HOST",
        "format": "{cluster}-{role}-{nn}"
      },
      {
        "role": "CVM",
        "format": "{cluster}-{role}-{nn}"
      },
      {
        "role": "ILO",
        "format": "{cluster}-{role}-{nn}"
      }
    ]
  }
}
