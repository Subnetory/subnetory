{
  "key": "nutanix-supermicro",
  "name": "Nutanix - Supermicro (hosts, CVM, IPMI)",
  "description": "Nutanix cluster on Supermicro nodes: all hosts, then all CVMs, then all IPMI.",
  "definition": {
    "allocation": "groups-sequential",
    "groupGap": 0,
    "ipStep": 1,
    "onOccupied": "block",
    "groups": [
      {
        "role": "HOST",
        "format": "{cluster}-{role}-{nn}"
      },
      {
        "role": "CVM",
        "format": "{cluster}-{role}-{nn}"
      },
      {
        "role": "IPMI",
        "format": "{cluster}-{role}-{nn}"
      }
    ]
  }
}
